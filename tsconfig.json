{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["jest", "node", "react-native"],
    "jsx": "react-native",
    "incremental": true
  },
  "include": ["src", "index.tsx", "*.config.{js,ts}"],
  "exclude": ["node_modules", ".husky", "ios", "android"]
}
