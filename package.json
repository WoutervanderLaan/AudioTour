{
  "name": "expo-rn-template",
  "version": "1.0.0",
  "private": true,
  "main": "index.tsx",
  "scripts": {
    "start": "APP_VARIANT=development expo start --dev-client",
    "start:reset:cache": "APP_VARIANT=development expo start --reset-cache",
    "web": "APP_VARIANT=development expo start --web",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios --device",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{js,jsx,ts,tsx}' --fix",
    "prepare": "husky",
    "clean": "react-native-clean-project",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit",
    "validate": "npm run lint && npm run typecheck && npm run format",
    "test": "jest --watchAll",
    "storybook-generate": "sb-rn-get-stories",
    "storybook": "APP_VARIANT=development storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/metro-runtime": "~57.0.2",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.4.0",
    "@notifee/react-native": "^9.1.8",
    "@react-navigation/bottom-tabs": "^7.18.5",
    "@react-navigation/elements": "^2.9.27",
    "@react-navigation/native": "^7.3.5",
    "@react-navigation/native-stack": "^7.17.7",
    "@tanstack/react-query": "^5.101.2",
    "dayjs": "^1.11.21",
    "expo": "^57.0.1",
    "expo-asset": "~57.0.2",
    "expo-blur": "~57.0.0",
    "expo-constants": "~57.0.2",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.3",
    "expo-dev-menu": "~57.0.4",
    "expo-device": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-image-picker": "~57.0.1",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.1",
    "expo-location": "~57.0.1",
    "expo-splash-screen": "~57.0.1",
    "expo-system-ui": "~57.0.0",
    "fast-text-encoding": "^1.0.6",
    "immer": "^10.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.80.0",
    "react-native": "0.86.0",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-unistyles": "^3.2.5",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^9.39.4",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native/jest-preset": "^0.86.0",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-ondevice-actions": "^10.4.7",
    "@storybook/addon-ondevice-controls": "^10.4.7",
    "@storybook/addon-viewport": "^9.0.8",
    "@storybook/react-native": "^10.4.7",
    "@storybook/react-native-web-vite": "^10.4.6",
    "@tanstack/eslint-plugin-query": "^5.101.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "babel-loader": "^8.4.1",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.4",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.7",
    "eslint-plugin-storybook": "^10.4.6",
    "eslint-plugin-unicorn": "^61.0.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.0",
    "lint-staged": "^16.4.0",
    "msw": "^2.14.6",
    "prettier": "^3.9.4",
    "react-native-clean-project": "^4.0.3",
    "react-native-reanimated": "4.5.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.0",
    "react-test-renderer": "19.2.3",
    "storybook": "^10.4.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-babel": "^1.7.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/.jest/jest-init.js"
    ],
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!react-native|@react-native|expo|msw|until-async|zustand|immer)"
    ],
    "setupFiles": [
      "react-native-unistyles/mocks",
      "./src/themes/unistyles.ts"
    ]
  }
}
